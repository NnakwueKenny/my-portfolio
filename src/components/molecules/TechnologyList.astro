---
interface Props {
  items: string[];
  labelledBy?: string;
  size?: 'compact' | 'chip';
  /** Show at most this many items and summarise the rest. */
  max?: number;
}

const { items, labelledBy, size = 'compact', max } = Astro.props;

const visible = max && items.length > max ? items.slice(0, max) : items;
const remaining = items.length - visible.length;

const icons: Record<string, string> = {
  'Next.js': '/images/dev-logos/nextjs.png',
  React: '/images/dev-logos/react.svg',
  'React Native': '/images/dev-logos/react.svg',
  Expo: '/images/dev-logos/expo.svg',
  'Expo Router': '/images/dev-logos/expo.svg',
  'Node.js': '/images/dev-logos/nodejs.svg',
  NestJS: '/images/dev-logos/nestjs.svg',
  TypeScript: '/images/dev-logos/typescript.svg',
  JavaScript: '/images/dev-logos/javascript.svg',
  NativeWind: '/images/dev-logos/tailwind.svg',
  Python: '/images/dev-logos/python.svg',
  FastAPI: '/images/dev-logos/fastapi.svg',
  Pydantic: '/images/dev-logos/pydantic.svg',
  PostgreSQL: '/images/dev-logos/postgresql.svg',
  SQLAlchemy: '/images/dev-logos/sqlalchemy.svg',
  MongoDB: '/images/dev-logos/mongodb.svg',
  Redis: '/images/dev-logos/redis.svg',
  Celery: '/images/dev-logos/celery.svg',
  Azure: '/images/dev-logos/azure.svg',
  AWS: '/images/dev-logos/aws.svg',
  Docker: '/images/dev-logos/docker.svg',
  'Docker Compose': '/images/dev-logos/docker.svg',
  Resend: '/images/dev-logos/resend.svg',
  OpenAPI: '/images/dev-logos/openapi.svg',
  Zod: '/images/dev-logos/zod.svg',
  Jest: '/images/dev-logos/jest.svg',
  Pytest: '/images/dev-logos/pytest.svg',
  pnpm: '/images/dev-logos/pnpm.svg',
  'Tailwind CSS': '/images/dev-logos/tailwind.svg',
  Netlify: '/images/dev-logos/netlify.svg',
};

const iconSize = size === 'chip' ? 18 : 16;
---

<ul class:list={['technology-list', `technology-list--${size}`]} aria-labelledby={labelledBy}>
  {visible.map((item) => (
    <li class:list={{ 'has-icon': Boolean(icons[item]) }}>
      {icons[item] && (
        <span class="technology-list__mark" aria-hidden="true">
          <img src={icons[item]} alt="" width={iconSize} height={iconSize} loading="lazy" decoding="async" />
        </span>
      )}
      <span>{item}</span>
    </li>
  ))}
  {remaining > 0 && (
    <li class="technology-list__more">
      <span>{`+${remaining} more`}</span>
    </li>
  )}
</ul>

<style>
  .technology-list {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .technology-list li {
    display: inline-flex;
    align-items: center;
    color: var(--muted);
  }

  /* A fixed mark box keeps logos of wildly different aspect ratios and
     padding on one optical baseline. */
  .technology-list__mark {
    display: inline-grid;
    flex: 0 0 auto;
    place-items: center;
  }

  .technology-list__mark img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .technology-list--compact {
    gap: 8px 16px;
  }

  .technology-list--compact li {
    gap: 7px;
    font-size: 0.78rem;
  }

  .technology-list--compact .technology-list__mark {
    width: 16px;
    height: 16px;
  }

  .technology-list--compact .technology-list__more {
    color: var(--line-strong);
    font-weight: 600;
  }

  .technology-list--chip {
    gap: 8px;
  }

  .technology-list--chip li {
    gap: 9px;
    padding: 7px 13px 7px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--paper-strong);
    color: var(--ink);
    font-size: 0.83rem;
    line-height: 1.2;
    transition: border-color 220ms ease, transform 260ms var(--ease-out);
  }

  .technology-list--chip li:not(.has-icon) {
    padding-left: 14px;
  }

  .technology-list--chip .technology-list__mark {
    width: 18px;
    height: 18px;
  }

  @media (hover: hover) {
    .technology-list--chip li:hover {
      border-color: var(--line-strong);
      transform: translateY(-2px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .technology-list--chip li:hover { transform: none; }
  }
</style>
