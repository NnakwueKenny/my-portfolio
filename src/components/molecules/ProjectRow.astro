---
import type { Project } from '../../data/site';
import TagList from '../atoms/TagList.astro';

interface Props {
  project: Project;
  index?: number;
}

const { project, index = 0 } = Astro.props;
const headingId = `project-${project.slug}`;
---

<article class="project-row" data-reveal style={`--reveal-delay: ${Math.min(index * 70, 210)}ms`}>
  <a
    class="project-row__visual"
    href={`/work/${project.slug}`}
    aria-labelledby={headingId}
    transition:name={`project-image-${project.slug}`}
  >
    <img
      src={project.image}
      alt={`${project.title} product interface`}
      width="1680"
      height="844"
      loading={index === 0 ? 'eager' : 'lazy'}
      decoding="async"
    />
  </a>

  <div class="project-row__content">
    <div class="project-row__meta">
      <span>{project.year}</span>
      <span>{project.role}</span>
    </div>
    <h3 id={headingId} transition:name={`project-title-${project.slug}`}>
      <a href={`/work/${project.slug}`}>
        <span>{project.title}</span>
        <img src="/icons/arrow-up-right.svg" alt="" width="18" height="18" />
      </a>
    </h3>
    <p>{project.description}</p>
    <p class="project-row__details">{project.contribution}</p>
    <TagList items={project.tags.slice(0, 4)} labelledBy={headingId} />
    <a class="text-link" href={`/work/${project.slug}`}>View case study</a>
  </div>
</article>
