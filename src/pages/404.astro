---
import ActionLink from '../components/atoms/ActionLink.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found — CodeHermit" description="The page you requested could not be found.">
  <section class="not-found shell">
    <p class="eyebrow">404</p>
    <h1>This route doesn’t lead anywhere useful.</h1>
    <p>The page may have moved, or the link may have been mistyped.</p>
    <ActionLink href="/">Return home</ActionLink>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    min-height: 72svh;
    justify-items: start;
    align-content: center;
    padding-block: 90px;
  }

  .not-found h1 {
    max-width: 980px;
    margin-bottom: 30px;
  }

  .not-found > p:not(.eyebrow) {
    margin-bottom: 30px;
    color: var(--muted);
    font-size: 1.18rem;
  }
</style>
