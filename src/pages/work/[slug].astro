---
import ActionLink from '../../components/atoms/ActionLink.astro';
import TechnologyList from '../../components/molecules/TechnologyList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/site';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const projectIndex = projects.findIndex((item) => item.slug === project.slug);
const nextProject = projects[(projectIndex + 1) % projects.length];
---

<BaseLayout title={`${project.title} — Kene · CodeHermit`} description={project.description} image={project.image}>
  <article class="case-study">
    <header class="case-study__hero shell">
      <div class="case-study__heading">
        <p class="eyebrow">Case study · {project.year}</p>
        <h1 transition:name={`project-title-${project.slug}`}>{project.title}</h1>
        <p>{project.description}</p>
      </div>

      <div class="case-study__facts">
        <dl>
          <div>
            <dt>Year</dt>
            <dd>{project.year}</dd>
          </div>
          <div>
            <dt>Role</dt>
            <dd>{project.role}</dd>
          </div>
          <div>
            <dt>Focus</dt>
            <dd>{project.tags.slice(0, 3).join(', ')}</dd>
          </div>
        </dl>
        <ActionLink href={project.url} variant="primary" external>Visit live product</ActionLink>
      </div>
    </header>

    <div class="case-study__media">
      <figure class="case-study__visual" transition:name={`project-image-${project.slug}`}>
        <img
          src={project.image}
          alt={`${project.title} product interface`}
          width="1680"
          height="844"
          style={`object-position: ${project.imagePosition ?? 'top center'}`}
        />
      </figure>

      <div class="case-study__caption">
        <p>{project.title} / Product interface</p>
        <a href={project.url} target="_blank" rel="noreferrer">
          Open live product
          <img src="/icons/external.svg" alt="" width="13" height="13" />
        </a>
      </div>
    </div>

    <div class="case-study__sections shell">
      <section class="case-study__section" data-reveal>
        <header>
          <p class="eyebrow">The product</p>
          <h2>Project overview</h2>
        </header>
        <div class="case-study__copy">
          <p class="case-study__lead">{project.overview}</p>
        </div>
      </section>

      <section class="case-study__section" data-reveal>
        <header>
          <p class="eyebrow">My role</p>
          <h2>Contribution</h2>
        </header>
        <div class="case-study__copy">
          <p class="case-study__lead">{project.contributionDetails}</p>
          <ul class="case-study__highlights" aria-label="Key areas of work">
            {project.highlights.map((highlight) => <li>{highlight}</li>)}
          </ul>
        </div>
      </section>

      <section class="case-study__section case-study__section--technology" data-reveal>
        <header>
          <p class="eyebrow">Technology</p>
          <h2>Built with</h2>
        </header>
        <div class="case-study__copy">
          <TechnologyList items={project.tags} size="large" />
        </div>
      </section>
    </div>

    <aside class="next-project" data-reveal>
      <a class="next-project__inner shell" href={`/work/${nextProject.slug}`}>
        <div class="next-project__copy">
          <p class="eyebrow">Next project</p>
          <h2>{nextProject.title}</h2>
          <p>{nextProject.description}</p>
          <span>
            View case study
            <img src="/icons/arrow-up-right.svg" alt="" width="18" height="18" />
          </span>
        </div>
        <div class="next-project__visual">
          <img src={nextProject.image} alt={`${nextProject.title} product interface`} width="1680" height="844" loading="lazy" />
        </div>
      </a>
    </aside>
  </article>
</BaseLayout>

<style>
  /* Editorial case-study template shared by every project route. */
  .case-study__hero {
    position: relative;
    display: grid;
    overflow: hidden;
    grid-template-columns: minmax(0, 1.15fr) minmax(300px, 0.46fr);
    gap: clamp(62px, 9vw, 132px);
    align-items: end;
    padding: clamp(76px, 9vw, 122px) clamp(30px, 5vw, 68px) clamp(58px, 7vw, 92px);
    isolation: isolate;
  }

  .case-study__hero::after {
    position: absolute;
    z-index: -1;
    top: 34px;
    right: -80px;
    width: 460px;
    height: 390px;
    background: url('/images/design/notebook-dots.png') center / 430px 430px;
    content: '';
    opacity: 0.46;
  }

  .case-study__heading { max-width: 920px; }

  .case-study__heading .eyebrow {
    margin-bottom: 28px;
    color: var(--accent);
    font-family: var(--font-hand);
    font-size: clamp(1.18rem, 1.55vw, 1.5rem);
    letter-spacing: 0;
    text-transform: none;
    transform: rotate(-1deg);
  }

  .case-study__heading h1 {
    max-width: 980px;
    margin-bottom: 28px;
    font-size: clamp(4.4rem, 8.8vw, 8rem);
  }

  .case-study__heading > p:last-child {
    max-width: 760px;
    margin-bottom: 0;
    color: var(--muted);
    font-size: clamp(1.18rem, 1.75vw, 1.48rem);
    line-height: 1.45;
  }

  .case-study__facts {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 32px;
    justify-items: start;
  }

  .case-study__facts dl {
    width: 100%;
    margin: 0;
    border-top: 1px solid var(--line-strong);
  }

  .case-study__facts dl div {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 18px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }

  .case-study__facts dt {
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .case-study__facts dd {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.45;
  }

  .case-study__media {
    width: min(1040px, var(--shell));
    margin-inline: auto;
  }

  .case-study__visual {
    width: 100%;
    margin: 0;
    background: var(--paper-strong);
  }

  .case-study__visual img {
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .case-study__caption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-block: 18px;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.74rem;
  }

  .case-study__caption p { margin: 0; }

  .case-study__caption a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
  }

  .case-study__sections { padding-top: clamp(72px, 9vw, 122px); }

  .case-study__section {
    display: grid;
    grid-template-columns: minmax(230px, 0.42fr) minmax(0, 1fr);
    gap: clamp(44px, 9vw, 138px);
    padding-block: clamp(52px, 7vw, 86px);
    border-top: 1px solid var(--line-strong);
  }

  .case-study__section:last-child { border-bottom: 1px solid var(--line-strong); }

  .case-study__section header .eyebrow {
    margin-bottom: 15px;
    color: var(--muted);
    font-family: var(--font-body);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transform: none;
  }

  .case-study__section h2 {
    max-width: 310px;
    margin: 0;
    font-size: clamp(2.35rem, 3.9vw, 4rem);
  }

  .case-study__copy { max-width: 790px; }

  .case-study__lead {
    max-width: 760px;
    margin: 0;
    color: var(--muted);
    font-size: clamp(1.05rem, 1.45vw, 1.2rem);
    line-height: 1.75;
  }

  .case-study__highlights {
    display: grid;
    margin: 36px 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .case-study__highlights li {
    position: relative;
    padding: 17px 0 17px 24px;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-size: 0.94rem;
    line-height: 1.6;
  }

  .case-study__highlights li::before {
    position: absolute;
    top: 25px;
    left: 0;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    content: '';
  }

  .case-study__section--technology .case-study__copy { max-width: 880px; }

  .case-study__section--technology .technology-list { margin-top: 4px; }

  .next-project {
    margin-top: clamp(72px, 9vw, 118px);
    padding-block: clamp(48px, 6vw, 70px);
    border-top: 1px dashed var(--line-strong);
  }

  .next-project__inner {
    display: grid;
    grid-template-columns: minmax(300px, 0.52fr) minmax(0, 0.78fr);
    gap: clamp(54px, 8vw, 116px);
    align-items: center;
    color: inherit;
    text-decoration: none;
  }

  .next-project__copy h2 {
    margin-bottom: 18px;
    font-size: clamp(3.3rem, 6vw, 6.4rem);
    transition: color 220ms ease;
  }

  .next-project__copy > p:not(.eyebrow) {
    max-width: 480px;
    color: var(--muted);
  }

  .next-project__copy span {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 14px;
    color: var(--accent);
    font-family: var(--font-hand);
    font-size: 1.25rem;
  }

  .next-project__copy span img { transition: transform 220ms var(--ease-out); }

  .next-project__visual {
    overflow: hidden;
    max-height: 380px;
  }

  .next-project__visual img {
    width: 100%;
    height: 100%;
    max-height: 380px;
    object-fit: contain;
    object-position: left center;
    transition: transform 700ms var(--ease-out);
  }

  .next-project__inner:hover h2 { color: var(--accent); }
  .next-project__inner:hover .next-project__copy span img { transform: translate(3px, -3px); }
  .next-project__inner:hover .next-project__visual img { transform: translateY(-5px); }

  @media (max-width: 980px) {
    .case-study__hero {
      grid-template-columns: 1fr;
      gap: 46px;
    }

    .case-study__facts { max-width: 640px; }

    .case-study__section { gap: 52px; }
  }

  @media (max-width: 720px) {
    .case-study__hero {
      gap: 38px;
      padding: 48px 0 46px;
    }

    .case-study__hero::after {
      top: 0;
      right: -170px;
      width: 360px;
      height: 300px;
      opacity: 0.36;
    }

    .case-study__heading .eyebrow { margin-bottom: 20px; }

    .case-study__heading h1 {
      margin-bottom: 22px;
      font-size: clamp(3.7rem, 18vw, 5.3rem);
    }

    .case-study__caption {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }

    .case-study__sections { padding-top: 60px; }

    .case-study__section {
      grid-template-columns: 1fr;
      gap: 28px;
      padding-block: 48px;
    }

    .case-study__section h2 { max-width: none; }

    .next-project { margin-top: 68px; padding-block: 48px 0; }

    .next-project__inner {
      grid-template-columns: 1fr;
      gap: 34px;
    }

    .next-project__visual { order: -1; }
  }
</style>
