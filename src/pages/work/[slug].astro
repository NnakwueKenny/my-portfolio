---
import ActionLink from '../../components/atoms/ActionLink.astro';
import TechnologyList from '../../components/molecules/TechnologyList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/site';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const projectIndex = projects.findIndex((item) => item.slug === project.slug);
const nextProject = projects[(projectIndex + 1) % projects.length];
---

<BaseLayout title={`${project.title} — Kene · CodeHermit`} description={project.description} image={project.image}>
  <article class="case-study">
    <header class="case-study__hero shell">
      <a class="case-study__back" href="/work">
        <img src="/icons/arrow-right.svg" alt="" width="16" height="16" />
        All work
      </a>

      <div class="case-study__intro">
        <div class="case-study__heading">
          <p class="eyebrow">Product · {project.year}</p>
          <h1 transition:name={`project-title-${project.slug}`}>{project.title}</h1>
        </div>

        <div class="case-study__introduction">
          <p class="case-study__description">{project.description}</p>
          <dl class="case-study__brief">
            <div>
              <dt>My role</dt>
              <dd>{project.role}</dd>
            </div>
            {project.surfaces && (
              <div>
                <dt>Product surfaces</dt>
                <dd>{project.surfaces}</dd>
              </div>
            )}
          </dl>
          <div class="case-study__action">
            <ActionLink href={project.url} variant="primary" external>Visit live product</ActionLink>
          </div>
        </div>
      </div>
    </header>

    <div class="case-study__media">
      <figure class="case-study__visual" transition:name={`project-image-${project.slug}`}>
        <img
          src={project.image}
          alt={`${project.title} product interface`}
          width="1680"
          height="844"
          style={`object-position: ${project.imagePosition ?? 'top center'}`}
        />
      </figure>

      <div class="case-study__caption">
        <p>{project.title} / Product interface</p>
        <a href={project.url} target="_blank" rel="noreferrer">
          Open live product
          <img src="/icons/external.svg" alt="" width="13" height="13" />
        </a>
      </div>
    </div>

    <section class="case-study__stack shell" aria-labelledby="project-stack-heading" data-reveal>
      <div>
        <p class="eyebrow">Product stack</p>
        <h2 id="project-stack-heading">Tools and technologies.</h2>
      </div>
      <TechnologyList items={project.tags} labelledBy="project-stack-heading" />
    </section>

    <div class="case-study__story shell">
      <section class="case-study__chapter" data-reveal>
        <header>
          <p class="eyebrow">Why it exists</p>
          <h2>{project.storyHeading ?? 'What the product needed to do.'}</h2>
        </header>
        <div class="case-study__copy">
          <p class="case-study__lead">{project.overview}</p>
        </div>
      </section>

      <section class="case-study__chapter" data-reveal>
        <header>
          <p class="eyebrow">What I built</p>
          <h2>{project.contributionHeading ?? 'What I was responsible for.'}</h2>
        </header>
        <div class="case-study__copy">
          <p class="case-study__lead">{project.contributionDetails}</p>
          <ul class="case-study__highlights" aria-label="Key areas of work">
            {project.highlights.map((highlight) => (
              <li>
                <img src="/icons/arrow-up-right.svg" alt="" width="16" height="16" />
                <span>{highlight}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    </div>

    <aside class="next-project" data-reveal>
      <a class="next-project__inner shell" href={`/work/${nextProject.slug}`}>
        <div class="next-project__copy">
          <p class="eyebrow">Next project</p>
          <h2>{nextProject.title}</h2>
          <p>{nextProject.description}</p>
          <span>
            View case study
            <img src="/icons/arrow-up-right.svg" alt="" width="18" height="18" />
          </span>
        </div>
        <div class="next-project__visual">
          <img src={nextProject.image} alt={`${nextProject.title} product interface`} width="1680" height="844" loading="lazy" />
        </div>
      </a>
    </aside>
  </article>
</BaseLayout>

<style>
  .case-study__hero {
    padding-top: clamp(40px, 5vw, 68px);
    padding-bottom: clamp(44px, 6vw, 78px);
  }

  .case-study__back {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-bottom: clamp(34px, 4vw, 54px);
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.03em;
    text-decoration: none;
  }

  .case-study__back img { transform: rotate(180deg); }

  .case-study__intro {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(340px, 0.72fr);
    gap: clamp(64px, 10vw, 152px);
    align-items: start;
  }

  .case-study__heading .eyebrow {
    margin-bottom: 17px;
    color: var(--accent);
    font-family: var(--font-hand);
    font-size: clamp(1.06rem, 1.25vw, 1.3rem);
    letter-spacing: 0;
    text-transform: none;
    transform: rotate(-1deg);
  }

  .case-study__heading h1 {
    max-width: 760px;
    margin: 0;
    font-size: clamp(2.8rem, 3.8vw, 4rem);
    line-height: 0.98;
  }

  .case-study__description {
    max-width: 600px;
    margin: 0;
    color: var(--muted);
    font-size: clamp(1.08rem, 1.35vw, 1.3rem);
    line-height: 1.55;
  }

  .case-study__brief {
    display: grid;
    gap: 17px;
    margin: 28px 0 0;
    padding: 22px 0 0;
    border-top: 1px solid var(--line);
  }

  .case-study__brief div {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr);
    gap: 18px;
  }

  .case-study__brief dt {
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .case-study__brief dd {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.55;
  }

  .case-study__action {
    margin-top: 28px;
  }

  .case-study__media {
    width: min(1180px, calc(100% - 40px));
    margin-inline: auto;
  }

  .case-study__visual {
    width: 100%;
    margin: 0;
  }

  .case-study__visual img {
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .case-study__caption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-block: 18px;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.74rem;
  }

  .case-study__caption p { margin: 0; }

  .case-study__caption a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
  }

  .case-study__stack {
    display: grid;
    grid-template-columns: minmax(220px, 0.34fr) minmax(0, 1fr);
    gap: clamp(44px, 8vw, 112px);
    padding-top: clamp(48px, 6vw, 72px);
    padding-bottom: clamp(58px, 8vw, 96px);
  }

  .case-study__stack .eyebrow,
  .case-study__chapter .eyebrow {
    margin-bottom: 12px;
    color: var(--muted);
    font-family: var(--font-body);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transform: none;
  }

  .case-study__stack h2 {
    margin: 0;
    font-size: clamp(2rem, 2.8vw, 3rem);
  }

  .case-study__story { border-top: 1px solid var(--line-strong); }

  .case-study__chapter {
    display: grid;
    grid-template-columns: minmax(280px, 0.76fr) minmax(0, 1fr);
    gap: clamp(56px, 9vw, 132px);
    padding-block: clamp(64px, 8vw, 104px);
    border-bottom: 1px solid var(--line-strong);
  }

  .case-study__chapter h2 {
    max-width: 520px;
    margin: 0;
    font-size: clamp(2.25rem, 3.55vw, 3.7rem);
    line-height: 1.04;
  }

  .case-study__copy { max-width: 790px; }

  .case-study__lead {
    max-width: 760px;
    margin: 0;
    color: var(--muted);
    font-size: clamp(1.05rem, 1.45vw, 1.2rem);
    line-height: 1.75;
  }

  .case-study__highlights {
    display: grid;
    margin: 36px 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .case-study__highlights li {
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr);
    gap: 12px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-size: 0.94rem;
    line-height: 1.6;
  }

  .case-study__highlights img { margin-top: 5px; }

  .next-project {
    margin-top: clamp(72px, 9vw, 118px);
    padding-block: clamp(48px, 6vw, 70px);
    border-top: 1px dashed var(--line-strong);
  }

  .next-project__inner {
    display: grid;
    grid-template-columns: minmax(300px, 0.52fr) minmax(0, 0.78fr);
    gap: clamp(54px, 8vw, 116px);
    align-items: center;
    color: inherit;
    text-decoration: none;
  }

  .next-project__copy h2 {
    margin-bottom: 18px;
    font-size: clamp(2.7rem, 4.5vw, 4.8rem);
    transition: color 220ms ease;
  }

  .next-project__copy > p:not(.eyebrow) {
    max-width: 480px;
    color: var(--muted);
  }

  .next-project__copy span {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 14px;
    color: var(--accent);
    font-family: var(--font-hand);
    font-size: 1.25rem;
  }

  .next-project__copy span img { transition: transform 220ms var(--ease-out); }

  .next-project__visual {
    overflow: hidden;
    max-height: 380px;
  }

  .next-project__visual img {
    width: 100%;
    height: 100%;
    max-height: 380px;
    object-fit: contain;
    object-position: left center;
    transition: transform 700ms var(--ease-out);
  }

  .next-project__inner:hover h2 { color: var(--accent); }
  .next-project__inner:hover .next-project__copy span img { transform: translate(3px, -3px); }
  .next-project__inner:hover .next-project__visual img { transform: translateY(-5px); }

  @media (max-width: 980px) {
    .case-study__intro { grid-template-columns: 1fr; gap: 42px; }
    .case-study__introduction { max-width: 680px; }
    .case-study__chapter { gap: 52px; }
  }

  @media (max-width: 720px) {
    .case-study__hero {
      padding-top: 30px;
      padding-bottom: 44px;
    }

    .case-study__back { margin-bottom: 34px; }

    .case-study__intro { gap: 32px; }

    .case-study__heading h1 {
      font-size: clamp(2.5rem, 10.8vw, 3rem);
      line-height: 1;
    }

    .case-study__brief div { grid-template-columns: 92px minmax(0, 1fr); }

    .case-study__media { width: calc(100% - 32px); }

    .case-study__caption {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }

    .case-study__stack {
      grid-template-columns: 1fr;
      gap: 30px;
      padding-top: 44px;
      padding-bottom: 62px;
    }

    .case-study__chapter {
      grid-template-columns: 1fr;
      gap: 28px;
      padding-block: 56px;
    }

    .case-study__chapter h2 { max-width: none; }

    .next-project { margin-top: 68px; padding-block: 48px 0; }

    .next-project__inner {
      grid-template-columns: 1fr;
      gap: 34px;
    }

    .next-project__visual { order: -1; }
  }
</style>
