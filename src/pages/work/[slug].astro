---
import ActionLink from '../../components/atoms/ActionLink.astro';
import TechnologyList from '../../components/molecules/TechnologyList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/site';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const projectIndex = projects.findIndex((item) => item.slug === project.slug);
const nextProject = projects[(projectIndex + 1) % projects.length];
const liveHost = new URL(project.url).host.replace(/^www\./, '');
const platePropsFor = (item: typeof project) =>
  [
    item.imageRatio && `--plate-ratio: ${item.imageRatio}`,
    item.imagePosition && `--plate-position: ${item.imagePosition}`,
  ]
    .filter(Boolean)
    .join('; ') || undefined;

const facts = [
  { term: 'Role', detail: project.role },
  ...(project.surfaces ? [{ term: 'Surfaces', detail: project.surfaces }] : []),
  { term: 'Year', detail: project.year },
];
---

<BaseLayout title={`${project.title} — Kene · CodeHermit`} description={project.description} image={project.image}>
  <article class="case-study">
    <header class="case-study__masthead">
      <a class="case-study__back" href="/work">
        <img src="/icons/arrow-right.svg" alt="" width="15" height="15" />
        All work
      </a>

      <p class="case-study__kicker">Case study <span aria-hidden="true">/</span> {project.year}</p>
      <h1 transition:name={`project-title-${project.slug}`}>{project.title}</h1>

      <div class="case-study__lede">
        <p class="case-study__deck">{project.description}</p>
        <ActionLink href={project.url} variant="primary" external>Visit live product</ActionLink>
      </div>

      <dl class="case-study__facts">
        {facts.map((fact) => (
          <div>
            <dt>{fact.term}</dt>
            <dd>{fact.detail}</dd>
          </div>
        ))}
        <div>
          <dt>Live</dt>
          <dd>
            <a class="case-study__fact-link" href={project.url} target="_blank" rel="noreferrer noopener">
              {liveHost}
              <img src="/icons/external.svg" alt="" width="12" height="12" />
            </a>
          </dd>
        </div>
      </dl>
    </header>

    <div class="case-study__media">
      <figure
        class="case-study__visual media-plate"
        transition:name={`project-image-${project.slug}`}
        style={platePropsFor(project)}
      >
        <div class="case-study__chrome" aria-hidden="true">
          <span class="case-study__chrome-dots"><i></i><i></i><i></i></span>
        </div>
        <img src={project.image} alt={`${project.title} product interface`} width="1680" height="1050" />
      </figure>
      <p class="case-study__caption">{project.title} — product interface</p>
    </div>

    <div class="case-study__story">
      <section class="case-study__chapter" data-reveal>
        <div class="case-study__rail">
          <p class="case-study__label">Why it exists</p>
        </div>
        <div class="case-study__copy">
          <h2>{project.storyHeading ?? 'What the product needed to do'}</h2>
          <p class="case-study__lead">{project.overview}</p>
        </div>
      </section>

      <section class="case-study__chapter" data-reveal>
        <div class="case-study__rail">
          <p class="case-study__label">What I built</p>
        </div>
        <div class="case-study__copy">
          <h2>{project.contributionHeading ?? 'What I was responsible for'}</h2>
          <p class="case-study__lead">{project.contributionDetails}</p>

          <ol class="case-study__highlights" aria-label="Key areas of work">
            {project.highlights.map((highlight, index) => (
              <li>
                <span class="case-study__highlight-index">{String(index + 1).padStart(2, '0')}</span>
                <span class="case-study__highlight-text">{highlight}</span>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="case-study__chapter" aria-labelledby="project-stack-heading" data-reveal>
        <div class="case-study__rail">
          <p class="case-study__label">Stack</p>
        </div>
        <div class="case-study__copy">
          <h2 id="project-stack-heading">Tools and technologies</h2>
          <p class="case-study__stack-note">
            {project.tags.length} technologies used across the product.
          </p>
          <TechnologyList items={project.tags} labelledBy="project-stack-heading" size="chip" />
        </div>
      </section>
    </div>

    <aside class="next-project" data-reveal>
      <a class="next-project__inner" href={`/work/${nextProject.slug}`}>
        <div class="next-project__copy">
          <p class="case-study__label">Next case study</p>
          <h2>{nextProject.title}</h2>
          <p>{nextProject.description}</p>
          <span class="next-project__cue">
            View case study
            <img src="/icons/arrow-up-right.svg" alt="" width="17" height="17" />
          </span>
        </div>
        <div class="next-project__visual media-plate" style={platePropsFor(nextProject)}>
          <img
            src={nextProject.image}
            alt={`${nextProject.title} product interface`}
            width="1680"
            height="1050"
            loading="lazy"
          />
        </div>
      </a>
    </aside>
  </article>
</BaseLayout>

<style>
  /* One inner measure for the whole case study so the masthead, capture, story,
     and handoff all sit on the same two edges. */
  .case-study {
    --case-shell: min(1180px, var(--shell));
  }

  .case-study__masthead,
  .case-study__media,
  .case-study__story,
  .next-project__inner {
    width: var(--case-shell);
    margin-inline: auto;
  }

  /* ---------- Masthead ---------- */

  .case-study__masthead {
    padding-top: clamp(30px, 4vw, 48px);
    padding-bottom: clamp(36px, 5vw, 60px);
  }

  .case-study__back {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-bottom: clamp(30px, 4vw, 48px);
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.03em;
    text-decoration: none;
    transition: color 200ms ease;
  }

  .case-study__back img {
    transform: rotate(180deg);
    transition: transform 260ms var(--ease-out);
  }

  .case-study__kicker {
    margin-bottom: 14px;
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .case-study__kicker span {
    padding-inline: 4px;
    color: var(--line-strong);
  }

  .case-study__masthead h1 {
    max-width: 14ch;
    margin: 0;
    font-size: clamp(2.6rem, 5.6vw, 4.6rem);
  }

  /* The deck and CTA sit under the title rather than in a second column, so
     there is no empty half-page beside the heading. */
  .case-study__lede {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 22px clamp(32px, 5vw, 60px);
    margin-top: clamp(22px, 3vw, 32px);
  }

  .case-study__deck {
    flex: 1 1 30ch;
    max-width: 46ch;
    margin: 0;
    color: var(--muted);
    font-size: clamp(1.06rem, 1.35vw, 1.26rem);
    line-height: 1.55;
  }

  .case-study__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    margin: clamp(38px, 5vw, 58px) 0 0;
    border-top: 1px solid var(--line-strong);
  }

  .case-study__facts > div {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px clamp(18px, 2.2vw, 30px) 20px 0;
    border-bottom: 1px solid var(--line);
  }

  .case-study__facts > div + div {
    padding-left: clamp(18px, 2.2vw, 30px);
    border-left: 1px solid var(--line);
  }

  .case-study__facts dt {
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .case-study__facts dd {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .case-study__fact-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
  }

  /* ---------- Media ---------- */

  .case-study__visual {
    margin: 0;
    --plate-ratio: 16 / 10;
  }

  /* A minimal browser bar frames each capture as a real, live product view and
     stops partial page screenshots from reading as a bad crop. */
  .case-study__chrome {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 0 16px;
    border-bottom: 1px solid var(--line);
    background: var(--paper);
    block-size: 38px;
  }

  .case-study__chrome-dots {
    display: inline-flex;
    flex: 0 0 auto;
    gap: 6px;
  }

  .case-study__chrome-dots i {
    display: block;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--line-strong);
  }

  .case-study__caption {
    padding-block: 14px;
    color: var(--muted);
    font-size: 0.74rem;
  }

  /* ---------- Story ---------- */

  .case-study__story {
    margin-top: clamp(28px, 4vw, 44px);
    border-top: 1px solid var(--line-strong);
  }

  .case-study__chapter {
    display: grid;
    grid-template-columns: minmax(150px, 0.24fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 84px);
    padding-block: clamp(52px, 6.5vw, 84px);
    border-bottom: 1px solid var(--line);
  }

  .case-study__chapter:last-child {
    padding-bottom: clamp(34px, 4vw, 52px);
    border-bottom: 0;
  }

  /* The label rail sticks so the narrow column stays company for the copy
     instead of leaving a tall empty gutter. */
  .case-study__rail {
    position: sticky;
    top: calc(var(--header-height) + 28px);
    align-self: start;
  }

  .case-study__label {
    margin: 0;
    color: var(--muted);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .case-study__label::after {
    display: block;
    width: 26px;
    height: 2px;
    margin-top: 12px;
    background: var(--accent);
    content: '';
  }

  .case-study__copy { max-width: 68ch; }

  .case-study__copy h2 {
    max-width: 22ch;
    margin: 0 0 20px;
    font-size: clamp(1.6rem, 2.4vw, 2.3rem);
    line-height: 1.1;
  }

  .case-study__lead {
    margin: 0;
    max-width: 64ch;
    color: var(--muted);
    font-size: clamp(1rem, 1.25vw, 1.1rem);
    line-height: 1.72;
  }

  .case-study__highlights {
    display: grid;
    gap: 1px;
    margin: clamp(30px, 4vw, 42px) 0 0;
    padding: 0;
    background: var(--line);
    border-radius: var(--radius);
    list-style: none;
    overflow: hidden;
  }

  .case-study__highlights li {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    gap: 14px;
    padding: 18px 20px;
    background: var(--paper-strong);
    font-size: 0.93rem;
    line-height: 1.62;
  }

  .case-study__highlight-index {
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 0.86rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1.72;
  }

  .case-study__stack-note {
    margin: -6px 0 22px;
    color: var(--muted);
    font-size: 0.86rem;
  }

  /* ---------- Next project ---------- */

  .next-project {
    margin-top: 0;
    padding-block: clamp(44px, 5.5vw, 68px);
    border-top: 1px solid var(--line-strong);
  }

  .next-project__inner {
    display: grid;
    grid-template-columns: minmax(280px, 0.8fr) minmax(0, 1fr);
    gap: clamp(36px, 5vw, 72px);
    align-items: center;
    color: inherit;
    text-decoration: none;
  }

  .next-project__copy .case-study__label { margin-bottom: 18px; }

  .next-project__copy h2 {
    margin-bottom: 12px;
    font-size: clamp(2rem, 3.2vw, 3rem);
    transition: color 220ms ease;
  }

  .next-project__copy > p:not(.case-study__label) {
    max-width: 42ch;
    margin-bottom: 0;
    color: var(--muted);
    font-size: 0.98rem;
  }

  .next-project__cue {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 18px;
    color: var(--accent);
    font-family: var(--font-hand);
    font-size: 1.25rem;
  }

  .next-project__cue img { transition: transform 260ms var(--ease-out); }

  .next-project__visual {
    --plate-ratio: 16 / 10;
    transition: box-shadow 420ms var(--ease-out), transform 420ms var(--ease-out), border-color 300ms ease;
  }

  .next-project__visual img { transition: transform 900ms var(--ease-glide); }

  @media (hover: hover) {
    .case-study__back:hover { color: var(--ink); }
    .case-study__back:hover img { transform: rotate(180deg) translateX(3px); }
    .case-study__fact-link:hover { text-decoration: underline; text-underline-offset: 0.25em; }
    .next-project__inner:hover h2 { color: var(--accent); }
    .next-project__inner:hover .next-project__cue img { transform: translate(3px, -3px); }

    .next-project__inner:hover .next-project__visual {
      border-color: var(--line-strong);
      box-shadow: var(--shadow-plate-hover);
      transform: translateY(-4px);
    }

    .next-project__inner:hover .next-project__visual img { transform: scale(1.02); }
  }

  @media (max-width: 980px) {
    .case-study__chapter {
      grid-template-columns: 1fr;
      gap: 22px;
    }

    .case-study__rail { position: static; }
    .case-study__copy { max-width: 72ch; }
    .case-study__facts > div + div { padding-left: 0; border-left: 0; }
    .case-study__facts > div:not(:last-child) { padding-right: 24px; }
  }

  @media (max-width: 720px) {
    .case-study__masthead { padding-top: 24px; padding-bottom: 34px; }
    .case-study__back { margin-bottom: 28px; }
    .case-study__masthead h1 { max-width: none; font-size: clamp(2.35rem, 10.5vw, 3rem); }
    .case-study__lede { align-items: flex-start; flex-direction: column; gap: 24px; }

    /* Stacked, the deck's flex-basis would become a height — reset it. */
    .case-study__deck { flex: 0 0 auto; max-width: none; }
    .case-study__facts { grid-template-columns: 1fr; }
    .case-study__chrome { padding-inline: 12px; block-size: 32px; }
    .case-study__chrome-dots i { width: 7px; height: 7px; }
    .case-study__chapter { padding-block: 44px; }
    .case-study__copy h2 { max-width: none; }
    .case-study__highlights li { grid-template-columns: 28px minmax(0, 1fr); gap: 10px; padding: 16px; }
    .next-project { margin-top: 48px; padding-block: 40px 0; }
    .next-project__inner { grid-template-columns: 1fr; gap: 28px; }
    .next-project__visual { order: -1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .case-study__rail { position: static; }
  }
</style>
