---
import ActionLink from '../../components/atoms/ActionLink.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Message sent — CodeHermit" description="Your message has been sent to CodeHermit.">
  <section class="success shell">
    <p class="eyebrow">Message sent</p>
    <h1>Thank you.<br />I’ll be in touch.</h1>
    <p>Your message made it through. I typically reply within 24 hours.</p>
    <ActionLink href="/">Return home</ActionLink>
  </section>
</BaseLayout>

<style>
  .success {
    display: grid;
    min-height: 70svh;
    justify-items: start;
    align-content: center;
    padding-block: 90px;
  }

  .success h1 {
    margin-bottom: 30px;
  }

  .success > p:not(.eyebrow) {
    margin-bottom: 30px;
    color: var(--muted);
    font-size: 1.18rem;
  }
</style>
