---
import ProjectRow from '../components/molecules/ProjectRow.astro';
import SectionIntro from '../components/molecules/SectionIntro.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile, projects } from '../data/site';

const featuredProjects = projects.filter((project) => project.featured);
---

<BaseLayout title={`${profile.familiarName} · ${profile.brandName} — ${profile.title}`}>
  <section class="home-hero shell">
    <div class="home-hero__copy">
      <h1 transition:name="home-headline">Hi, I’m Kene.</h1>
      <p class="home-hero__title">Senior software engineer.</p>
      <p class="home-hero__summary">I build production software across frontend, backend, and cloud—and currently lead engineering at Techsense Developers.</p>

      <div class="home-hero__actions">
        <a class="hero-button hero-button--primary" href="#selected-work">
          <span>See my work</span>
          <img src="/icons/arrow-up-right.svg" alt="" width="17" height="17" />
        </a>
        <a class="hero-button hero-button--secondary" href="/contact">
          <img src="/icons/envelope.svg" alt="" width="19" height="19" />
          <span>Get in touch</span>
        </a>
        <div class="home-hero__reply-note">
          <img src="/icons/arrow-return-right.svg" alt="" width="36" height="36" />
          <p class="home-hero__reply">I typically reply<br />within a day.</p>
        </div>
      </div>
    </div>

    <div class="home-hero__visual" data-portrait-stage>
      <div class="home-hero__dots" aria-hidden="true"></div>
      <img class="home-hero__portrait-arrow" src="/icons/arrow-curve-right.svg" alt="" width="48" height="48" />
      <figure class="home-hero__portrait" transition:name="portrait" data-portrait-card>
        <img
          class="home-hero__photo"
          src="/images/kenechukwu-nnakwue-2026.jpg"
          alt={`${profile.fullName}, ${profile.title}`}
          width="2157"
          height="2346"
          fetchpriority="high"
        />
        <img class="home-hero__tape" src="/images/design/masking-tape.png" alt="" width="600" height="215" />
      </figure>
      <p class="home-hero__note">Engineer first,<br />builder always.</p>
    </div>
  </section>

  <section class="selected-work shell" id="selected-work">
    <div class="selected-work__heading" data-reveal>
      <h2>Selected work</h2>
      <a href="/work">View all work <img src="/icons/arrow-right.svg" alt="" width="17" height="17" /></a>
    </div>
    <div class="selected-work__list">
      {featuredProjects.map((project, index) => <ProjectRow project={project} index={index} />)}
    </div>
  </section>

  <section class="home-profile shell">
    <SectionIntro
      eyebrow="A bit about me"
      title="I work across engineering, product, and delivery."
      copy="My current work combines technical direction, product architecture, hands-on engineering, mentoring, and the operating habits that help teams deliver consistently."
      align="split"
    />
    <div class="home-profile__columns">
      <article data-reveal>
        <h3>Architecture</h3>
        <p>Turning product requirements into systems that are clear to build, scale, and operate.</p>
      </article>
      <article data-reveal style="--reveal-delay: 70ms">
        <h3>Engineering</h3>
        <p>Working across frontend applications, APIs, data, integrations, infrastructure, and delivery pipelines.</p>
      </article>
      <article data-reveal style="--reveal-delay: 140ms">
        <h3>Leadership</h3>
        <p>Setting direction, reviewing decisions, mentoring engineers, and improving how teams work together.</p>
      </article>
    </div>
  </section>

  <script>
    const initialisePortrait = () => {
      const stage = document.querySelector<HTMLElement>('[data-portrait-stage]');
      const card = document.querySelector<HTMLElement>('[data-portrait-card]');
      if (!stage || !card || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const update = (event: PointerEvent) => {
        const bounds = stage.getBoundingClientRect();
        const x = (event.clientX - bounds.left) / bounds.width - 0.5;
        const y = (event.clientY - bounds.top) / bounds.height - 0.5;
        card.style.setProperty('--portrait-rotate-x', `${y * -2.2}deg`);
        card.style.setProperty('--portrait-rotate-y', `${x * 2.8}deg`);
      };

      const reset = () => {
        card.style.setProperty('--portrait-rotate-x', '0deg');
        card.style.setProperty('--portrait-rotate-y', '0deg');
      };

      stage.addEventListener('pointermove', update, { passive: true });
      stage.addEventListener('pointerleave', reset, { passive: true });
    };

    document.addEventListener('astro:page-load', initialisePortrait);
  </script>
</BaseLayout>

<style>
  .home-hero {
    display: grid;
    min-height: 588px;
    grid-template-columns: minmax(0, 1.08fr) minmax(380px, 0.72fr);
    gap: clamp(44px, 6vw, 92px);
    align-items: center;
    padding: 30px clamp(30px, 5vw, 68px) 34px;
  }

  .home-hero__copy { position: relative; z-index: 2; max-width: 760px; }

  .home-hero h1 {
    margin-bottom: 31px;
    font-size: clamp(4.1rem, 6vw, 6.05rem);
    opacity: 0;
    transform: translateY(34px);
    animation: hero-in 820ms var(--ease-out) 80ms forwards;
  }

  .home-hero__title,
  .home-hero__summary {
    max-width: 690px;
    margin-bottom: 7px;
    font-size: clamp(1.48rem, 2.25vw, 2.12rem);
    line-height: 1.35;
    letter-spacing: -0.025em;
  }

  .home-hero__summary { margin-bottom: 38px; }

  .home-hero__title,
  .home-hero__summary,
  .home-hero__actions {
    opacity: 0;
    transform: translateY(26px);
    animation: hero-in 760ms var(--ease-out) forwards;
  }

  .home-hero__title { animation-delay: 190ms; }
  .home-hero__summary { animation-delay: 280ms; }
  .home-hero__actions { animation-delay: 390ms; }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 22px;
  }

  .hero-button {
    display: inline-flex;
    min-height: 56px;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 13px 23px;
    border: 1px solid var(--ink);
    border-radius: var(--radius);
    text-decoration: none;
    transition: transform 220ms var(--ease-out), background-color 180ms ease, color 180ms ease;
  }

  .hero-button img { flex: 0 0 auto; }
  .hero-button--primary { background: var(--ink); color: white; }
  .hero-button--primary img { filter: invert(1); }
  .hero-button--secondary { background: transparent; }
  .hero-button:hover { transform: translateY(-3px); }
  .hero-button--secondary:hover { background: white; }

  .home-hero__reply {
    margin: 0;
    color: var(--accent);
    font-family: var(--font-hand);
    font-size: 1.38rem;
    line-height: 1.03;
    transform: rotate(-2deg);
  }

  .home-hero__reply-note {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: 8px;
  }

  .home-hero__reply-note > img,
  .home-hero__portrait-arrow {
    filter: invert(32%) sepia(80%) saturate(1830%) hue-rotate(204deg) brightness(79%) contrast(95%);
  }

  .home-hero__reply-note > img { transform: rotate(8deg); }

  .home-hero__visual {
    position: relative;
    min-height: 490px;
    opacity: 0;
    perspective: 1200px;
    transform: translateY(38px) scale(0.98);
    animation: hero-visual-in 900ms var(--ease-out) 260ms forwards;
  }

  .home-hero__dots {
    position: absolute;
    inset: 0 -32px 26px -148px;
    background: url('/images/design/notebook-dots.png') center / 470px 470px;
    opacity: 0.9;
  }

  .home-hero__portrait-arrow {
    position: absolute;
    z-index: 2;
    bottom: 108px;
    left: -54px;
    width: 52px;
    height: 52px;
    transform: rotate(-10deg);
  }

  .home-hero__portrait {
    --portrait-rotate-x: 0deg;
    --portrait-rotate-y: 0deg;
    position: absolute;
    z-index: 1;
    top: 18px;
    right: 40px;
    width: min(82%, 404px);
    margin: 0;
    padding: 11px 11px 17px;
    background: #fdfcf8;
    box-shadow: 0 10px 20px rgba(41, 35, 27, 0.15);
    transform: rotate(1.3deg) rotateX(var(--portrait-rotate-x)) rotateY(var(--portrait-rotate-y));
    transition: transform 300ms var(--ease-out), box-shadow 300ms ease;
    transform-style: preserve-3d;
  }

  .home-hero__portrait:hover { box-shadow: 0 16px 30px rgba(41, 35, 27, 0.18); }

  .home-hero__photo {
    width: 100%;
    height: auto;
    object-fit: cover;
    object-position: center 18%;
    filter: saturate(0.9) contrast(1.02);
  }

  .home-hero__tape {
    position: absolute;
    z-index: 2;
    top: -22px;
    right: -16px;
    width: 86px;
    height: auto;
    transform: rotate(9deg);
  }

  .home-hero__note {
    position: absolute;
    right: -12px;
    bottom: 0;
    z-index: 2;
    margin: 0;
    color: #33312d;
    font-family: var(--font-hand);
    font-size: 1.2rem;
    line-height: 1.05;
    transform: rotate(-3deg);
  }

  .home-hero__note::after {
    display: block;
    width: 92px;
    height: 2px;
    margin-top: 8px;
    background: var(--accent);
    content: '';
    transform: rotate(-2deg);
  }

  .selected-work {
    padding-top: 40px;
    border-top: 1px dashed var(--line-strong);
  }

  .selected-work__heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    padding: 0 clamp(30px, 5vw, 68px) 18px;
  }

  .selected-work__heading h2 { margin: 0; font-size: clamp(1.6rem, 2.1vw, 2.05rem); }

  .selected-work__heading h2::after {
    display: block;
    width: 136px;
    height: 2px;
    margin-top: 8px;
    background: var(--accent);
    content: '';
    transform: scaleX(0) rotate(-1deg);
    transform-origin: left center;
    transition: transform 720ms var(--ease-out) 180ms;
  }

  .selected-work__heading.is-visible h2::after { transform: scaleX(1) rotate(-1deg); }

  .selected-work__heading a {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--accent);
    font-family: var(--font-hand);
    font-size: 1.35rem;
    text-decoration: none;
  }

  .home-profile { padding-top: clamp(98px, 12vw, 158px); }

  .home-profile__columns {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-block: 1px solid var(--line-strong);
  }

  .home-profile article {
    padding: 32px clamp(22px, 3vw, 38px) 38px;
    border-right: 1px solid var(--line);
  }

  .home-profile article:first-child { padding-left: 0; }
  .home-profile article:last-child { padding-right: 0; border-right: 0; }
  .home-profile h3 { margin-bottom: 16px; font-size: clamp(1.65rem, 2.3vw, 2.35rem); }
  .home-profile p { margin-bottom: 0; color: var(--muted); }

  @keyframes hero-in { to { opacity: 1; transform: translateY(0); } }

  @keyframes hero-visual-in {
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (max-width: 1080px) {
    .home-hero { grid-template-columns: minmax(0, 1fr) minmax(310px, 0.62fr); gap: 38px; }
    .home-hero h1 { font-size: clamp(3.7rem, 7vw, 5.1rem); }
    .home-hero__title,
    .home-hero__summary { font-size: clamp(1.35rem, 2.7vw, 1.85rem); }
    .home-hero__portrait { right: 24px; }
    .home-hero__note { right: 0; }
    .home-hero__portrait-arrow { display: none; }
  }

  @media (max-width: 780px) {
    .home-hero { grid-template-columns: 1fr; padding: 40px 0 34px; }
    .home-hero__visual { width: min(100%, 540px); min-height: 510px; justify-self: center; }
    .home-hero__dots { inset: 12px -12px 42px -12px; background-size: 430px 430px; opacity: 0.88; }
    .home-hero__portrait {
      right: 50%;
      width: min(78vw, 390px);
      transform: translateX(50%) rotate(1.3deg) rotateX(var(--portrait-rotate-x)) rotateY(var(--portrait-rotate-y));
    }
    .home-hero__note { right: 6px; }
    .home-profile__columns { grid-template-columns: 1fr; }
    .home-profile article,
    .home-profile article:first-child,
    .home-profile article:last-child { padding: 26px 0; border-right: 0; border-bottom: 1px solid var(--line); }
    .home-profile article:last-child { border-bottom: 0; }
  }

  @media (max-width: 560px) {
    .home-hero { min-height: auto; padding-top: 30px; }
    .home-hero h1 { margin-bottom: 24px; font-size: clamp(3.4rem, 16.5vw, 4.5rem); }
    .home-hero__title,
    .home-hero__summary { font-size: 1.28rem; }
    .home-hero__actions { display: grid; grid-template-columns: 1fr; gap: 12px; }
    .hero-button { width: 100%; padding-inline: 18px; }
    .home-hero__reply-note { grid-column: 1 / -1; margin: 12px 0 0; }
    .home-hero__visual { min-height: 430px; }
    .home-hero__portrait { width: min(86vw, 350px); }
    .home-hero__note { right: -4px; bottom: -2px; font-size: 1.05rem; }
    .selected-work { padding-top: 30px; }
    .selected-work__heading { align-items: flex-start; padding-inline: 0; }
    .selected-work__heading a { font-size: 1.12rem; }
  }
</style>
